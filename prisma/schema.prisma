datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentType {
  MOVIE
  BOOK
  STORY
  HISTORY
  FOLKLORE
  USER_CONTEXT
}

enum RightsStatus {
  PUBLIC_DOMAIN
  LICENSED
  USER_PROVIDED
  UNKNOWN
  RESTRICTED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  STALE
}

enum SourceType {
  OFFICIAL
  ENCYCLOPEDIA
  NEWS
  DATABASE
  OTHER
}

model ContentSource {
  id                 String             @id @default(uuid())
  title              String
  normalizedTitle    String             @unique
  contentType        ContentType
  description        String?
  language           String             @default("English")
  genre              String?
  releaseDate        String?
  externalIds        Json?
  metadata           Json?
  rightsStatus       RightsStatus       @default(UNKNOWN)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  contentHash        String?
  lastVerifiedAt     DateTime           @default(now())
  embedding          String?            // JSON serialized float array for pgvector match fallback
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  aliases     ContentAlias[]
  references  ContentReference[]
  scripts     StorytellingScript[]
  characters  Character[]
  narrators   NarratorProfile[]

  @@map("content_sources")
}

model ContentAlias {
  id              String        @id @default(uuid())
  contentSourceId String
  alias           String
  normalizedAlias String        @unique
  createdAt       DateTime      @default(now())
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  @@map("content_aliases")
}

model ContentReference {
  id              String        @id @default(uuid())
  contentSourceId String
  url             String
  title           String
  publisher       String?
  sourceType      SourceType    @default(OTHER)
  retrievedAt     DateTime      @default(now())
  evidence        String        @db.Text
  rightsEvidence  String?       @db.Text
  isPrimary       Boolean       @default(false)
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  @@map("content_references")
}

model StorytellingScript {
  id              String        @id @default(uuid())
  contentSourceId String
  mode            String
  language        String        @default("English")
  script          String        @db.Text
  model           String
  provider        String
  promptVersion   String        @default("1.0")
  rightsMode      String        @default("ORIGINAL_RETETTLING")
  qualityScore    Float         @default(1.0)
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  scenes          SceneBeat[]

  @@map("storytelling_scripts")
}

model SceneBeat {
  id               String             @id @default(uuid())
  scriptId         String
  beatIndex        Int
  narrationText    String             @db.Text
  visualPrompt     String             @db.Text
  cameraDirective  String             @default("MEDIUM_SHOT")
  lightingMood     String             @default("DRAMATIC_NATURAL")
  estimatedSeconds Float              @default(5.0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  script           StorytellingScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("scene_beats")
}

model Character {
  id                 String        @id @default(uuid())
  contentSourceId    String
  name               String
  role               String
  ageGroup           String
  genderPresentation String
  personality        String
  appearance         String
  importance         String        @default("MEDIUM")
  confidence         Float         @default(1.0)
  createdAt          DateTime      @default(now())
  contentSource      ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  @@map("characters")
}

model NarratorProfile {
  id                 String        @id @default(uuid())
  contentSourceId    String
  ageGroup           String
  genderPresentation String
  tone               String
  emotion            String
  pace               String
  language           String        @default("English")
  accent             String        @default("Neutral")
  style              String
  audience           String
  reasoning          String        @db.Text
  confidence         Float         @default(1.0)
  selectedProvider   String
  selectedModel      String
  createdAt          DateTime      @default(now())
  contentSource      ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  @@map("narrator_profiles")
}

model AIJob {
  id          String   @id @default(uuid())
  jobType     String
  status      String
  provider    String
  model       String
  latencyMs   Int
  error       String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("ai_jobs")
}
