datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ContentType {
  MOVIE
  BOOK
  STORY
  HISTORY
  FOLKLORE
  USER_CONTEXT
}

enum RightsStatus {
  PUBLIC_DOMAIN
  LICENSED
  USER_PROVIDED
  UNKNOWN
  RESTRICTED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  STALE
}

enum SourceType {
  OFFICIAL
  ENCYCLOPEDIA
  NEWS
  DATABASE
  OTHER
}

model ContentSource {
  id                 String             @id @default(uuid())
  title              String
  normalizedTitle    String             @unique
  contentType        ContentType
  description        String?
  language           String             @default("English")
  genre              String?
  releaseDate        String?
  externalIds        Json?
  metadata           Json?
  rightsStatus       RightsStatus       @default(UNKNOWN)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  contentHash        String?
  lastVerifiedAt     DateTime           @default(now())
  embedding          String?            // JSON serialized float array for pgvector match fallback
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  aliases     ContentAlias[]
  references  ContentReference[]
  scripts     StorytellingScript[]
  characters  Character[]
  narrators   NarratorProfile[]

  @@map("content_sources")
}

model ContentAlias {
  id              String        @id @default(uuid())
  contentSourceId String
  alias           String
  normalizedAlias String        @unique
  createdAt       DateTime      @default(now())
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  @@map("content_aliases")
}

model ContentReference {
  id              String        @id @default(uuid())
  contentSourceId String
  url             String
  title           String
  publisher       String?
  sourceType      SourceType    @default(OTHER)
  retrievedAt     DateTime      @default(now())
  evidence        String        @db.Text
  rightsEvidence  String?       @db.Text
  isPrimary       Boolean       @default(false)
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  @@map("content_references")
}

model StorytellingScript {
  id              String        @id @default(uuid())
  contentSourceId String
  mode            String
  language        String        @default("English")
  script          String        @db.Text
  model           String
  provider        String
  promptVersion   String        @default("1.0")
  rightsMode      String        @default("ORIGINAL_RETETTLING")
  qualityScore    Float         @default(1.0)
  version         Int           @default(1)
  createdAt       DateTime      @default(now())
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  scenes          SceneBeat[]

  @@map("storytelling_scripts")
}

model SceneBeat {
  id               String             @id @default(uuid())
  scriptId         String
  beatIndex        Int
  narrationText    String             @db.Text
  visualPrompt     String             @db.Text
  cameraDirective  String             @default("MEDIUM_SHOT")
  lightingMood     String             @default("DRAMATIC_NATURAL")
  estimatedSeconds Float              @default(5.0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  script           StorytellingScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@map("scene_beats")
}

model Character {
  id                 String            @id @default(uuid())
  contentSourceId    String
  name               String
  role               String
  ageGroup           String
  genderPresentation String
  personality        String
  appearance         String
  importance         String            @default("MEDIUM")
  confidence         Float             @default(1.0)
  createdAt          DateTime          @default(now())
  contentSource      ContentSource     @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  visuals            CharacterVisual[]

  @@map("characters")
}

model CharacterVisual {
  id               String    @id @default(uuid())
  characterId      String
  seed             Int       @default(424242)
  faceEmbedding    String?   // Vector embedding representation
  turnaroundPrompt String    @db.Text
  avatarUrl        String?
  clothingStyle    String    @default("Casual Classic")
  consistencyScore Float     @default(0.95)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_visuals")
}

model NarratorProfile {
  id                 String        @id @default(uuid())
  contentSourceId    String
  ageGroup           String
  genderPresentation String
  tone               String
  emotion            String
  pace               String
  language           String        @default("English")
  accent             String        @default("Neutral")
  style              String
  audience           String
  reasoning          String        @db.Text
  confidence         Float         @default(1.0)
  selectedProvider   String
  selectedModel      String
  createdAt          DateTime      @default(now())
  contentSource      ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  @@map("narrator_profiles")
}

model AIJob {
  id          String   @id @default(uuid())
  jobType     String
  status      String
  provider    String
  model       String
  latencyMs   Int
  error       String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("ai_jobs")
}

model StylePreset {
  id               String   @id @default(uuid())
  name             String   @unique
  category         String   @default("Cinematic")
  promptModifier   String   @db.Text
  negativePrompt   String?  @db.Text
  paletteTags      String[]
  coherenceScore   Float    @default(0.95)
  createdAt        DateTime @default(now())

  @@map("style_presets")
}

model EnvironmentRef {
  id               String   @id @default(uuid())
  locationName     String
  stylePresetName  String
  environmentPrompt String  @db.Text
  coherenceScore   Float    @default(0.95)
  createdAt        DateTime @default(now())

  @@map("environment_refs")
}

model KeyframeImage {
  id               String   @id @default(uuid())
  sceneId          String
  prompt           String   @db.Text
  imageUrl         String
  provider         String   @default("replicate-sdxl")
  width            Int      @default(1024)
  height           Int      @default(1024)
  seed             Int      @default(424242)
  isUpscaled       Boolean  @default(false)
  status           String   @default("COMPLETED")
  createdAt        DateTime @default(now())

  @@map("keyframe_images")
}

model VoiceSynthesis {
  id               String   @id @default(uuid())
  text             String   @db.Text
  voiceId          String
  provider         String   @default("elevenlabs")
  audioUrl         String
  durationSeconds  Float    @default(5.0)
  emotion          String   @default("Neutral")
  speed            Float    @default(1.0)
  pitch            Float    @default(1.0)
  createdAt        DateTime @default(now())

  @@map("voice_syntheses")
}

model AudioTrack {
  id               String   @id @default(uuid())
  title            String
  trackType        String   @default("MUSIC") // MUSIC | SFX | AMBIENT
  genreOrMood      String
  audioUrl         String
  durationSeconds  Float    @default(30.0)
  duckingDb        Float    @default(-12.0)
  createdAt        DateTime @default(now())

  @@map("audio_tracks")
}

model VideoMotion {
  id               String   @id @default(uuid())
  sceneId          String
  sourceImageUrl   String
  videoUrl         String
  motionType       String   @default("PAN_RIGHT") // PAN_LEFT | PAN_RIGHT | ZOOM_IN | ZOOM_OUT | ORBIT | TILT_UP
  motionStrength   Float    @default(5.0)
  provider         String   @default("runway-gen3")
  durationSeconds  Float    @default(4.0)
  status           String   @default("COMPLETED")
  createdAt        DateTime @default(now())

  @@map("video_motions")
}

model Timeline {
  id               String   @id @default(uuid())
  scriptId         String   @unique
  tracks           Json     // Array of track metadata with clips
  totalDuration    Float    @default(0.0)
  fps              Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("timelines")
}

model Subtitle {
  id               String   @id @default(uuid())
  scriptId         String
  language         String   @default("English")
  cues             Json     // Array of { startTime, endTime, text }
  srtExportUrl     String?
  vttExportUrl     String?
  createdAt        DateTime @default(now())

  @@map("subtitles")
}

model RenderJob {
  id               String   @id @default(uuid())
  scriptId         String
  resolution       String   @default("1080p") // 720p | 1080p | 4K
  fps              Int      @default(30)
  outputVideoUrl   String?
  progressPercent  Int      @default(0)
  status           String   @default("QUEUED") // QUEUED | RENDERING | COMPLETED | FAILED | CANCELLED
  renderTimeMs     Int?
  createdAt        DateTime @default(now())

  @@map("render_jobs")
}

model JobQueue {
  id               String   @id @default(uuid())
  taskName         String
  payload          Json
  status           String   @default("QUEUED") // QUEUED | ACTIVE | COMPLETED | FAILED | RETRYING
  attempts         Int      @default(0)
  maxAttempts      Int      @default(3)
  webhookUrl       String?
  lastError        String?  @db.Text
  createdAt        DateTime @default(now())

  @@map("job_queues")
}

model SocialExport {
  id               String   @id @default(uuid())
  scriptId         String
  aspectRatio      String   @default("16:9") // 16:9 | 9:16 | 1:1 | 4:5
  targetPlatform   String   @default("YouTube") // YouTube | TikTok | Instagram | Reels | Shorts
  width            Int      @default(1920)
  height           Int      @default(1080)
  exportUrl        String
  hashtags         String[]
  createdAt        DateTime @default(now())

  @@map("social_exports")
}

model PromptTemplate {
  id               String   @id @default(uuid())
  name             String   @unique
  category         String   @default("Character Visual")
  templateText     String   @db.Text
  negativePrompt   String?  @db.Text
  tokenEstimate    Int      @default(50)
  createdAt        DateTime @default(now())

  @@map("prompt_templates")
}
