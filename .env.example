# Supabase PostgreSQL Database URLs
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# AI Provider API Keys
CLAUDE_API_KEY="sk-ant-api03-..."
GEMINI_API_KEY="AIzaSy..."
GROQ_API_KEY="gsk_..."

# AI Router Configuration
AI_DEFAULT_PROVIDER="claude"
AI_TRANSLATION_PROVIDER_ORDER="claude,groq,gemini"
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_MODEL="gemini-3.6-flash"
# Optional: CLAUDE_MODEL="claude-3-5-sonnet-20240620"
TRANSLATION_PARAGRAPH_DELAY_MS="0"
# Cloud API translation — capped at 4 to avoid Groq TPM bursts
TRANSLATION_CLOUD_CONCURRENCY="3"
AI_FALLBACK_ENABLED="true"
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_RETRIES="2"

# Application Settings
PORT=3001
APP_BASE_URL="http://localhost:3000"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ey..."

# Local Emotion Engine (offline ML tagger + Piper /narrate — no paid APIs)
EMOTION_ENGINE_URL="http://127.0.0.1:8000"
EMOTION_ENGINE_ENABLED="true"
EMOTION_ENGINE_TAG_TIMEOUT_MS="120000"
EMOTION_ENGINE_NARRATE_TIMEOUT_MS="600000"
EMOTION_ENGINE_NARRATE_TIMEOUT_MAX_MS="1800000"
EMOTION_ENGINE_HEALTH_TIMEOUT_MS="5000"
# Manual-only rollback to ElevenLabs/Google — never set automatically
USE_LEGACY_ELEVENLABS="false"
EMOTION_JOY_HIGH_THRESHOLD="0.7"
EMOTION_SADNESS_HIGH_THRESHOLD="0.7"
EMOTION_FEAR_HIGH_THRESHOLD="0.7"
EMOTION_ANGER_HIGH_THRESHOLD="0.7"
EMOTION_SURPRISE_HIGH_THRESHOLD="0.6"
